# Telegram API 凭证（从 https://my.telegram.org 获取）
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here

# 要监控的群组（逗号分隔，推荐 username 或数字 chat id；invite link 会过期，不建议长期使用）
TG_TARGET_GROUPS=groupusername1,-1001234567890

# 你自己的 Telegram User ID（可以发消息给 @userinfobot 获取）
TG_MY_USER_ID=123456789

# 实时告警 Bot（可选）：@BotFather 创建后填 token，并先给 bot 发一次 /start
# 留空则告警发到「已保存消息」
TELEGRAM_BOT_TOKEN=

# 是否把自己的发言从情绪分析里剔除（可选，默认 true；设为 false 则不剔除）
TG_EXCLUDE_SELF=true

# Anthropic API Key（必填）
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key（运行 pnpm agent 时必填）
OPENAI_API_KEY=sk-...

# 模型分层（可选）：light 跑高频轻量评分，deep 跑重要深度分析
# 两档默认都使用 Claude Sonnet 5；需要时可分别覆盖
MODEL_LIGHT=claude-sonnet-5
MODEL_DEEP=claude-sonnet-5
# 实时告警的深度分析与单票分析（达到阈值才跑，次数少），默认 Opus 5.5
MODEL_ALERT=claude-opus-5-5

# 分析配置
SENTIMENT_BATCH_SIZE=20            # 每多少条消息分析一次
SIMPLE_ANALYSIS_MIN_ABS_SCORE=0.5  # 方向轴 |score|>=0.5 进入深度分析（不调行情）
HEAT_DEEP_THRESHOLD=0.6           # 烈度轴 heat>=0.6 也进深度分析（与 score 阈值独立，仅理解不推送）
HEAT_PUSH_THRESHOLD=0.8           # 纯烈度告警 finalHeat>=0.8 才推送过热摘要，否则只落库+日志
ALERT_MIN_ABS_SCORE=0.8            # 实时告警：深度复核 |score|>=0.8 才推送
ALERT_MIN_HEAT=0.85                # 或 heat>=0.85 才推送；其余只落库
ALERT_COOLDOWN_MINUTES=30          # 同一个群冷却时间
ALERT_ESCALATION_DELTA=0.05        # 冷却期内强度比上次高出此值仍推
MENTION_WINDOW_MINUTES=30         # 提及异动：统计窗口
MENTION_SPIKE_MIN_COUNT=8          # 窗口内至少被提次数
MENTION_SPIKE_RATIO=4              # 且至少是平时的倍数
MENTION_LOOKBACK_DAYS=7            # 基线回看天数
MENTION_COOLDOWN_MINUTES=120       # 同一只票冷却时间
MENTION_WATCHLIST=                 # 只盯这些 Yahoo symbol（逗号分隔），留空=全部
MONITOR_MIN_ABS_SCORE=0.6          # >=0.6 深度分析会调取实时行情
ASSET_DETAIL_MIN_ABS_SCORE=0.65    # >=0.65 发总览+Top3单票分析
ASSET_DETAIL_COUNT=3               # 单票分析数量

# 今日综合总结固定分析的大盘 Yahoo Finance symbol（逗号分隔）
REPORT_BENCHMARKS=^N225

# 发言追踪（pnpm user-report）：单独追踪某些群成员的发言并整理他们提到的股票
# 数字 user ID，逗号分隔；可用 pnpm db:inspect 或 sqlite 按显示名查 sender_id
TG_WATCH_USER_IDS=
# 监听进程内定时触发（JST cron，统计当天 00:00 至触发时刻），留空不启用
# 盘中时段请用这个而不是单独起进程，避免和监听同时用同一个 session
USER_REPORT_CRON=
