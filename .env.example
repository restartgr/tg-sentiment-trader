# Telegram API 凭证（从 https://my.telegram.org 获取）
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here

# 要监控的群组（逗号分隔，推荐 username 或数字 chat id；invite link 会过期，不建议长期使用）
TG_TARGET_GROUPS=groupusername1,-1001234567890

# 你自己的 Telegram User ID（可以发消息给 @userinfobot 获取）
TG_MY_USER_ID=123456789

# Anthropic API Key（必填）
ANTHROPIC_API_KEY=sk-ant-...

# 模型分层（可选）：light 跑高频轻量评分，deep 跑重要深度分析
MODEL_LIGHT=claude-haiku-4-5
MODEL_DEEP=claude-sonnet-4-6

# 分析配置
SENTIMENT_BATCH_SIZE=30            # 每多少条消息分析一次
SIMPLE_ANALYSIS_MIN_ABS_SCORE=0.6  # >=0.6 进入深度分析（不调行情）
MONITOR_MIN_ABS_SCORE=0.65         # >=0.65 深度分析会调取实时行情
ASSET_DETAIL_MIN_ABS_SCORE=0.75    # >=0.75 发总览+Top3单票分析
ASSET_DETAIL_COUNT=3               # 单票分析数量
