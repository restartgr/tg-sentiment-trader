# Telegram API 凭证（从 https://my.telegram.org 获取）
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here

# 要监控的群组（逗号分隔，推荐 username 或数字 chat id；invite link 会过期，不建议长期使用）
TG_TARGET_GROUPS=groupusername1,-1001234567890

# 你自己的 Telegram User ID（可以发消息给 @userinfobot 获取）
TG_MY_USER_ID=123456789

# 是否把自己的发言从情绪分析里剔除（可选，默认 true；设为 false 则不剔除）
TG_EXCLUDE_SELF=true

# Anthropic API Key（必填）
ANTHROPIC_API_KEY=sk-ant-...

# 模型分层（可选）：light 跑高频轻量评分，deep 跑重要深度分析
# Haiku 首轮评分偏差大，默认 light 也用 Sonnet；想省钱可改回 claude-haiku-4-5
MODEL_LIGHT=claude-sonnet-5
MODEL_DEEP=claude-sonnet-5

# 分析配置
SENTIMENT_BATCH_SIZE=20            # 每多少条消息分析一次
SIMPLE_ANALYSIS_MIN_ABS_SCORE=0.5  # 方向轴 |score|>=0.5 进入深度分析（不调行情）
HEAT_DEEP_THRESHOLD=0.6           # 烈度轴 heat>=0.6 也进深度分析（与 score 阈值独立，仅理解不推送）
HEAT_PUSH_THRESHOLD=0.8           # 纯烈度告警 finalHeat>=0.8 才推送过热摘要，否则只落库+日志
MONITOR_MIN_ABS_SCORE=0.6          # >=0.6 深度分析会调取实时行情
ASSET_DETAIL_MIN_ABS_SCORE=0.65    # >=0.65 发总览+Top3单票分析
ASSET_DETAIL_COUNT=3               # 单票分析数量

# 今日综合总结固定分析的大盘 Yahoo Finance symbol（逗号分隔）
REPORT_BENCHMARKS=^N225
